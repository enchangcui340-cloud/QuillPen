{
  "name": "dsh-quill-user",
  "version": "1.0.0",
  "private": true,
  "description": "把 Quill（本地笔记 / 待办 / 白板）搬进 DSH 的「笔记」面板",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tools": {
      "default": "./lib/tools.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "6.3.289",
    "ssh2": "^1.16.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "ssh2",
      "cpu-features",
      "@napi-rs/canvas"
    ]
  }
}
